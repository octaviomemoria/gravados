# Meeting Studio - variaveis de ambiente de exemplo.
# Copie para .env e ajuste localmente. Nunca commitar .env com valores reais.

# Nivel de log estruturado do processo main (error | warn | info | debug | silly)
MEETING_STUDIO_LOG_LEVEL=info

# Sobrescreve a pasta raiz da biblioteca local (padrao: Documentos/MeetingStudio)
MEETING_STUDIO_LIBRARY_ROOT=

# Reservado para a fase de IA/transcricao (07_AI_TRANSCRIPTION_KNOWLEDGE.md).
# NAO usado nesta fase. Nunca commitar uma chave real.
# OPENAI_API_KEY=
